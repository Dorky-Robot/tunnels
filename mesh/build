#!/bin/sh
# Generate the mesh's shared files from its inventory.
#
#   sh mesh/build            regenerate them
#   sh mesh/build --check    fail if what is committed is not what the inventory makes
#
# Inputs, and the only things to edit:
#   mesh/machines         every machine, one line each
#   mesh/accounts         every GitHub account a machine can push as
#   mesh/hostkeys/<name>  that machine's /etc/ssh host keys, read from the machine itself
#   mesh/keys/<name>.pub  that machine's ~/.ssh/id_mesh_ed25519.pub
#
# Outputs, committed so a machine can install without building:
#   mesh/mesh.conf         ssh: every machine, three ways in
#   mesh/mesh_known_hosts  ssh: their host keys, under every name they answer to
#   mesh/github.conf       ssh: every GitHub account, by alias
#   mesh/authorized_keys   the block install.sh keeps in ~/.ssh/authorized_keys
#
# mesh/github_known_hosts is an input too, but from GitHub rather than from us;
# `sh mesh/build --github-hostkeys` refreshes it from api.github.com/meta.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
M=$here/machines A=$here/accounts
die() { echo "build: $*" >&2; exit 1; }

# GitHub's published ed25519 host key. The refresh refuses anything else.
GH_ED25519=SHA256:+DiY3wvvV6TuJJhbpZisF/zLDA0zPMSvHdkr4UvCOqU

if [ "${1:-}" = --github-hostkeys ]; then
  meta=$(mktemp); trap 'rm -f "$meta"' EXIT
  curl -fsS https://api.github.com/meta > "$meta" || die "could not fetch api.github.com/meta"
  i=0; : > "$here/github_known_hosts.new"
  while k=$(plutil -extract "ssh_keys.$i" raw -o - "$meta" 2>/dev/null); do
    echo "github.com $k" >> "$here/github_known_hosts.new"; i=$((i+1))
  done
  fp=$(grep ' ssh-ed25519 ' "$here/github_known_hosts.new" | ssh-keygen -lf - | cut -d' ' -f2)
  [ "$fp" = "$GH_ED25519" ] || { rm -f "$here/github_known_hosts.new"; die "api.github.com/meta gave ed25519 $fp, not $GH_ED25519"; }
  mv "$here/github_known_hosts.new" "$here/github_known_hosts"
  echo "github_known_hosts: $(wc -l < "$here/github_known_hosts" | tr -d ' ') keys"; exit 0
fi

rows() { grep -v '^[[:space:]]*#' "$1" | awk 'NF'; }

# ---- check the inventory before writing anything from it -----------------
[ -z "$(rows "$M" | awk '{print $1}' | sort | uniq -d)" ] || die "a name appears twice in machines"
[ -z "$(rows "$M" | awk '{print $6}' | sort | uniq -d)" ] || die "two machines share a vnc port"
accts=$(rows "$A" | awk -F'|' '{gsub(/ /,"",$1); print $1}')
rows "$M" | while read -r name host user ip tunnel vnc github aliases; do
  [ -n "$github" ] || die "$name: machines needs 7 columns (aliases may be empty)"
  [ -s "$here/hostkeys/$name" ] || die "$name: no mesh/hostkeys/$name"
  [ -s "$here/keys/$name.pub" ] || die "$name: no mesh/keys/$name.pub"
  [ "$github" = - ] || printf '%s\n' "$accts" | grep -qx "$github" || die "$name: github account '$github' is not in accounts"
done
[ "$(rows "$A" | awk -F'|' '$4 ~ /(^| )github\.com( |$)/' | wc -l | tr -d ' ')" = 1 ] \
  || die "exactly one account must list plain github.com"

out=$(mktemp -d); trap 'rm -rf "$out"' EXIT

# ---- mesh.conf ------------------------------------------------------------
cat > "$out/mesh.conf" <<'HEADER'
# ~/.ssh/config.d/mesh.conf
#
# GENERATED by mesh/build from mesh/machines — edit that, not this. It is
# IDENTICAL on every machine in the mesh: a copy that drifts is how one box
# quietly cannot reach another while the rest look fine.
#
# Every machine answers three ways, and each fails for different reasons:
#
#   <name>              the tailnet   boot daemon, works from anywhere — the default
#   <name>-lan          the LAN       mDNS; the one that survives the internet being down
#   cloudflare-<name>   the tunnel    the connector that also serves the public sites
#
# 2026-09-21: Doug's mini had one path, and it was the tunnel. Restarting
# the tunnel cut the only way in, and a live site stayed down until somebody
# logged in at the machine by hand. Keep all three.
#
# One key reaches every box (id_mesh_ed25519, one per machine, authorized on
# all of them) and one known_hosts vouches for them (mesh_known_hosts, built
# from each machine's own /etc/ssh host keys). ProxyCommand finds cloudflared
# on PATH because mac2019 is Intel and keeps Homebrew in /usr/local.
#
# Every direct path says `ProxyCommand none` out loud. ssh takes the first
# value for each option but only for options a block actually sets, so a
# box's own older `Host doug-mini` block with a ProxyCommand in it would
# otherwise leak into the tailnet path and send it through cloudflared —
# which is what broke two of the sixteen paths the first time this went out.
HEADER
awk '
  /^[[:space:]]*#/ { note = note $0 "\n"; next }
  !NF { note = ""; next }
  {
    name=$1; host=$2; user=$3; tunnel=$5; aliases=""
    for (i = 8; i <= NF; i++) aliases = aliases " " $i
    common = "  User " user "\n  IdentityFile ~/.ssh/id_mesh_ed25519\n  IdentitiesOnly yes\n  UserKnownHostsFile ~/.ssh/config.d/mesh_known_hosts ~/.ssh/known_hosts\n"
    printf "\n\n# ── %s ──\n%s", host, note
    printf "Host %s%s %s\n  HostName %s\n  ProxyCommand none\n%s", name, aliases, host, host, common
    printf "Host %s-lan %s.local\n  HostName %s.local\n  ProxyCommand none\n%s", name, host, host, common
    if (tunnel != "-")
      printf "Host cloudflare-%s\n  HostName %s\n  User %s\n  ProxyCommand /usr/bin/env PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin cloudflared access ssh --hostname %%h\n  IdentityFile ~/.ssh/id_mesh_ed25519\n  IdentitiesOnly yes\n  UserKnownHostsFile ~/.ssh/config.d/mesh_known_hosts ~/.ssh/known_hosts\n", name, tunnel, user
    note = ""
  }' "$M" | sed '1{/^$/d;}' >> "$out/mesh.conf"

# ---- mesh_known_hosts and authorized_keys --------------------------------
: > "$out/mesh_known_hosts"
printf '# GENERATED by mesh/build from mesh/keys — install.sh keeps this block in\n# ~/.ssh/authorized_keys, between its markers. Remove a machine here, and\n# the next install on every box stops letting it in.\n' > "$out/authorized_keys"
rows "$M" | while read -r name host user ip tunnel vnc github aliases; do
  names="$host,$ip,$host.local"; [ "$tunnel" = - ] || names="$names,$tunnel"
  awk -v n="$names" 'NF {print n, $1, $2}' "$here/hostkeys/$name" >> "$out/mesh_known_hosts"
  cat "$here/keys/$name.pub" >> "$out/authorized_keys"
done

# ---- github.conf -----------------------------------------------------------
cat > "$out/github.conf" <<'HEADER'
# ~/.ssh/config.d/github.conf
#
# GENERATED by mesh/build from mesh/accounts — edit that, not this. The same
# on every machine; which accounts a machine can actually use is which of
# these keys it has. Each key is made on its machine by `github-key-setup`
# and never copied, so dropping a machine is deleting one key on GitHub.
#
# GitHub's host keys come from mesh/github_known_hosts, checked against the
# fingerprints GitHub publishes, so no machine trusts github.com on first use.
HEADER
rows "$A" | awk -F'|' '
  function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
  {
    acct=trim($1); key=trim($2); hosts=trim($4)
    printf "\n# %s\nHost %s\n  HostName github.com\n  User git\n  IdentityFile ~/.ssh/%s\n  IdentitiesOnly yes\n  UserKnownHostsFile ~/.ssh/config.d/github_known_hosts ~/.ssh/known_hosts\n  # a long pre-push hook must not cost the push its connection\n  ServerAliveInterval 60\n  ServerAliveCountMax 5\n", acct, hosts, key
  }' >> "$out/github.conf"

# ---- write, or compare -----------------------------------------------------
stale=
for f in mesh.conf mesh_known_hosts github.conf authorized_keys; do
  if [ "${1:-}" = --check ]; then
    cmp -s "$out/$f" "$here/$f" || { echo "build: mesh/$f is not what the inventory makes" >&2; stale=1; }
  else
    cp "$out/$f" "$here/$f"
  fi
done
[ -z "$stale" ] || die "run: sh mesh/build, and commit what it changes"
[ "${1:-}" = --check ] && echo "build: up to date" || echo "build: wrote mesh.conf mesh_known_hosts github.conf authorized_keys"
