<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.dorkyrobot.tunnel-watchdog</string>
  <!-- The same watchdog as a LaunchDaemon, in /Library/LaunchDaemons. It
       is there at boot without a login, and system daemons came through the
       2026-09-23 upgrade that stranded every user agent. Run as root the
       script looks after whoever is at the console. Needs sudo to install:
       docs/remote-access.md, "The watchdog". -->
  <key>ProgramArguments</key><array>
    <string>/bin/sh</string><string>/usr/local/bin/tunnel-watchdog.sh</string>
  </array>
  <!-- Every minute by the clock, not StartInterval. After the macOS 27
       upgrade (2026-09-23) launchd left every RunAtLoad/StartInterval agent
       at runs = 0 for fourteen hours, this one included; the only jobs that
       ran were StartCalendarInterval ones. An empty dict fires every minute:
       a stranded agent is kicked within a minute of the console login, which
       is what lets doug-mini be all back within five minutes of power-on.
       A healthy run is silent and takes about 0.1 s, and launchd never
       starts a second copy of a label that is still running. -->
  <key>StartCalendarInterval</key><dict/>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>/var/log/tunnel-watchdog.log</string>
</dict></plist>
